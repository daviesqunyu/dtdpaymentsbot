async function renderTrade() {
  $('#app').innerHTML = `
    <div class="ambient"></div>
    <section>
      <div class="eyebrow"><span class="kicker-dot"></span>Spot Desk</div>
      <h1 class="page-title">Spot Desk</h1>
      <p class="page-subtitle mb-4">Live Binance trading — candlestick charts, order book, and order execution.</p>
      <div class="card">
        <h3 style="margin-bottom:1rem;color:var(--text)">Market Ticker</h3>
        <div class="table">
          <thead><tr><th>Symbol</th><th>Price</th><th>24h Change</th><th>Bid</th><th>Ask</th></tr></thead>
          <tbody id="tickerBody"><tr><td colspan="5" class="text-cyber-muted text-sm">Loading…</td></tr></tbody>
        </div>
      </div>
    </section>
  `;
  try {
    const res = await fetch('https://api.binance.com/api/v3/ticker/24hr');
    const tickers = await res.json();
    const symbols = ['BTCUSDT','ETHUSDT','BNBUSDT','SOLUSDT','XRPUSDT','DOGEUSDT'];
    $('#tickerBody').innerHTML = symbols.map(s => {
      const t = tickers.find(x => x.symbol === s);
      if (!t) return '';
      const change = Number(t.priceChangePercent);
      const color = change >= 0 ? 'var(--neon-green)' : 'var(--neon-red)';
      return `<tr><td><span class="mono">${s}</span></td><td><span class="mono">${Number(t.lastPrice).toFixed(2)}</span></td><td style="color:${color}">${change.toFixed(2)}%</td><td><span class="mono">${Number(t.bidPrice).toFixed(2)}</span></td><td><span class="mono">${Number(t.askPrice).toFixed(2)}</span></td></tr>`;
    }).join('');
  } catch { $('#tickerBody').innerHTML = `<tr><td colspan="5" class="text-cyber-muted text-sm">Unable to load market data.</td></tr>`; }
}

async function renderSmtp() {
  $('#app').innerHTML = `
    <div class="ambient"></div>
    <section style="max-width:600px;margin:0 auto">
      <div class="eyebrow"><span class="kicker-dot"></span>SMTP Vault</div>
      <h1 class="page-title">SMTP Vault</h1>
      <p class="page-subtitle mb-4">Bulk email, carrier SMS gateways, and live OTP inbox. Admin unlock required.</p>
      <div class="card">
        <div class="form-group">
          <label class="form-label">Admin JWT Token</label>
          <input type="password" id="smtpAdminJwt" class="form-input" placeholder="Paste admin JWT">
        </div>
        <button class="btn btn-primary btn-sm" id="smtpBtnUnlock">Unlock</button>
        <div id="smtpAlert"></div>
      </div>
    </section>
  `;
  $('#smtpBtnUnlock').onclick = async () => {
    const jwt = $('#smtpAdminJwt').value.trim();
    const alertEl = $('#smtpAlert');
    try {
      const r = await api('/api/smtp/unlock', { method: 'POST', body: { mode: 'admin', adminJwt: jwt } });
      alertEl.innerHTML = '<div class="alert alert-success">✅ Admin console unlocked.</div>';
    } catch (e) { alertEl.innerHTML = '<div class="alert alert-error">' + escapeHtml(e.message) + '</div>'; }
  };
}

async function renderChat() {
  $('#app').innerHTML = `
    <div class="ambient"></div>
    <section style="max-width:900px;margin:0 auto">
      <div class="eyebrow"><span class="kicker-dot"></span>Store Chat</div>
      <h1 class="page-title">Store Chat</h1>
      <p class="page-subtitle mb-4">Live chat support. Request callbacks or message us on Telegram.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap">
        <div style="flex:1;min-width:280px">
          <div class="card mb-4">
            <div class="chat-messages" id="chatMessages">
              <div class="text-cyber-muted text-sm text-center mt-4">Connecting to chat feed…</div>
            </div>
          </div>
          <form id="chatForm" class="chat-form">
            <input type="text" id="chatMessage" class="chat-input" placeholder="Type a message…" required>
            <input type="text" id="chatContact" class="chat-input" placeholder="Phone or @username (optional)">
            <button type="submit" class="btn btn-primary btn-sm">Send</button>
          </form>
        </div>
        <div style="width:340px">
          <div class="card">
            <h3 style="margin-bottom:1rem;color:var(--text)">Request Callback</h3>
            <form id="callbackForm">
              <div class="form-group"><label class="form-label">Name</label><input type="text" id="cbName" class="form-input" placeholder="Your name" required></div>
              <div class="form-group"><label class="form-label">Contact</label><input type="text" id="cbContact" class="form-input" placeholder="Phone or @username" required></div>
              <div class="form-group"><label class="form-label">Topic</label><input type="text" id="cbTopic" class="form-input" placeholder="What do you need help with?"></div>
              <button class="btn btn-primary btn-block btn-sm" type="submit">Request Callback</button>
            </form>
            <div id="cbStatus" class="mt-2 text-cyber-muted text-sm"></div>
          </div>
          <div class="card mt-4">
            <h3 style="margin-bottom:1rem;color:var(--text)">Join Telegram</h3>
            <p class="text-cyber-muted text-sm mb-3">Get instant support and updates on our Telegram bot.</p>
            <a href="${TELEGRAM_BOT}" class="btn btn-outline btn-block" target="_blank" rel="noopener">Open Telegram Bot</a>
            <a href="${TELEGRAM_CHANNEL}" class="btn btn-ghost btn-block mt-2" target="_blank" rel="noopener">Join Channel</a>
          </div>
        </div>
      </div>
    </section>
  `;
  $('#chatForm').onsubmit = async (e) => {
    e.preventDefault();
    const message = sanitizeInput($('#chatMessage').value.trim());
    const contact = sanitizeInput($('#chatContact').value.trim());
    if (!message) return;
    try {
      await api('/api/telegram/message', { method: 'POST', body: { message, name: 'Store Customer', contact: contact || undefined } });
      $('#chatMessage').value = '';
    } catch (err) { alert(err.message); }
  };
  $('#callbackForm').onsubmit = async (e) => {
    e.preventDefault();
    const status = $('#cbStatus');
    try {
      await api('/api/call-requests', { method: 'POST', body: { name: $('#cbName').value.trim(), phone: $('#cbContact').value.trim(), topic: $('#cbTopic').value.trim(), message: 'Callback requested', preferredTime: '' } });
      status.textContent = '✅ Callback requested — we will contact you shortly.';
      status.style.color = 'var(--neon-green)';
      $('#callbackForm').reset();
    } catch (err) { status.textContent = '❌ ' + err.message; status.style.color = 'var(--neon-red)'; }
  };
}

async function renderTrack() {
  $('#app').innerHTML = `
    <div class="ambient"></div>
    <section style="max-width:520px;margin:0 auto">
      <div class="eyebrow"><span class="kicker-dot"></span>Track Order</div>
      <h1 class="page-title">Track Order</h1>
      <p class="page-subtitle mb-4">Enter your Order ID and email to check payment and delivery status.</p>
      <div class="card tracking-card">
        <div class="tracking-panel">
          <h3 class="tracking-title text-sm font-medium uppercase tracking-letter-spacing mb-4">Order Lookup</h3>
          <div class="field-group">
            <div class="form-field">
              <label class="label-field" for="order-id">Order ID</label>
              <input type="text" id="trackOrderId" class="input-field font-mono" placeholder="e.g. DTD-abc123" required />
              <span class="validation-icon">✓</span>
              <div class="field-error text-xs text-[var(--danger)] hidden" id="trackOrderIdError">Order ID is required</div>
            </div>
            <div class="form-field">
              <label class="label-field" for="trackEmail">Email</label>
              <input type="email" id="trackEmail" class="input-field" placeholder="you@example.com" required />
              <span class="validation-icon">✓</span>
              <div class="field-error text-xs text-[var(--danger)] hidden" id="trackEmailError">Valid email is required</div>
            </div>
          </div>
        </div>
        <div class="submit-area">
          <button type="submit" class="btn-primary w-full tracking-submit" id="trackBtn">Track Order</button>
          <div class="submitting-state hidden" id="submittingState">
            <span class="spinner mr-2"></span>Checking status...
          </div>
        </div>
      </div>
      <div id="trackResult" class="mt-6"></div>
    </section>
  `;
  $('#trackBtn').onclick = async () => {
    const rawOrderId = $('#trackOrderId').value.trim();
    const rawEmail = $('#trackEmail').value.trim();
    const orderId = sanitizeInput(rawOrderId);
    const email = sanitizeInput(rawEmail);
    const resultEl = $('#trackResult');
    const orderIdError = $('#trackOrderIdError');
    const emailError = $('#trackEmailError');
    const submittingState = $('#submittingState');
    const trackBtn = $('#trackBtn');
    const orderIdInput = $('#trackOrderId');
    const emailInput = $('#trackEmail');

    // Reset previous errors and styles
    if (orderIdError) orderIdError.classList.add('hidden');
    if (emailError) emailError.classList.add('hidden');
    if (orderIdInput) orderIdInput.classList.remove('has-error');
    if (emailInput) emailInput.classList.remove('has-error');

    // Validate order ID pattern
    if (!orderId || !PATTERNS.orderId.test(orderId)) {
      if (orderIdError) orderIdError.textContent = 'Order ID must match format: DTD-abc123';
      if (orderIdError) orderIdError.classList.remove('hidden');
      if (orderIdInput) orderIdInput.classList.add('has-error');
      return;
    }

    // Validate email pattern
    if (!email || !PATTERNS.email.test(email)) {
      if (emailError) emailError.textContent = 'Please enter a valid email address';
      if (emailError) emailError.classList.remove('hidden');
      if (emailInput) emailInput.classList.add('has-error');
      return;
    }

    // Show submitting state, hide result
    if (submittingState) submittingState.classList.remove('hidden');
    if (trackBtn) trackBtn.classList.add('hidden');

    try {
      const { order } = await api(`/api/orders/status?orderId=${encodeURIComponent(orderId)}&email=${encodeURIComponent(email)}`);
      resultEl.innerHTML = `
        <div class="alert alert-success">✅ Order found</div>
        <table class="table mt-2">
          <tr><th>Order ID</th><td>${escapeHtml(order.id)}</td></tr>
          <tr><th>Payment Method</th><td>${escapeHtml(order.paymentMethod || '—')}</td></tr>
          <tr><th>Payment Status</th><td><span class="mono">${escapeHtml(order.paymentStatus || '—')}</span></td></tr>
          <tr><th>Order Status</th><td>${escapeHtml(order.statusLabel || order.orderStatus || '—')}</td></tr>
          <tr><th>Amount Paid</th><td>$${Number(order.totalUsd || order.amountPaid || 0).toFixed(2)} USD</td></tr>
        </table>
      `;
      resultEl.classList.remove('hidden');
    } catch (e) {
      resultEl.innerHTML = '<div class="alert alert-error">' + escapeHtml(e.message) + '</div>';
      resultEl.classList.remove('hidden');
    } finally {
      // Hide submitting state
if (submittingState) submittingState.classList.add('hidden');
    if (trackBtn) trackBtn.classList.remove('hidden');
  }
}

// Real-time validation for tracking form
document.addEventListener('DOMContentLoaded', () => {
  const trackOrderIdInput = document.getElementById('trackOrderId');
  const trackEmailInput = document.getElementById('trackEmail');
  const orderIdError = document.getElementById('trackOrderIdError');
  const emailError = document.getElementById('trackEmailError');

  if (trackOrderIdInput) {
    trackOrderIdInput.oninput = () => {
      const value = sanitizeInput(trackOrderIdInput.value.trim());
      if (value && PATTERNS.orderId.test(value)) {
        trackOrderIdInput.classList.remove('has-error');
        if (orderIdError) orderIdError.classList.add('hidden');
      }
    };
    trackOrderIdInput.onblur = () => {
      const value = sanitizeInput(trackOrderIdInput.value.trim());
      if (!value || !PATTERNS.orderId.test(value)) {
        trackOrderIdInput.classList.add('has-error');
        if (orderIdError) {
          orderIdError.textContent = 'Order ID must match format: DTD-abc123';
          orderIdError.classList.remove('hidden');
        }
      }
    };
  }

  if (trackEmailInput) {
    trackEmailInput.oninput = () => {
      const value = sanitizeInput(trackEmailInput.value.trim());
      if (value && PATTERNS.email.test(value)) {
        trackEmailInput.classList.remove('has-error');
        if (emailError) emailError.classList.add('hidden');
      }
    };
    trackEmailInput.onblur = () => {
      const value = sanitizeInput(trackEmailInput.value.trim());
      if (!value || !PATTERNS.email.test(value)) {
        trackEmailInput.classList.add('has-error');
        if (emailError) {
          emailError.textContent = 'Please enter a valid email address';
          emailError.classList.remove('hidden');
        }
      }
    };
  }
});
  };
}
