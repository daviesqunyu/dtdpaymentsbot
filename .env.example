# Copy to .env and fill in your values

PORT=5173

# Supabase (iqoffsnkptulvuqmdcce project)
SUPABASE_URL=https://iqoffsnkptulvuqmdcce.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key
PAYSTACK_SECRET_KEY=sk_live_your_secret_key

# Bitcoin deposit address
BTC_ADDRESS=your_btc_wallet_address

# Telegram bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
# Private DM for chat widget messages and admin order copies
TELEGRAM_ADMIN_CHAT_ID=your_numeric_telegram_user_id
# Channel for public order notifications (bot must be channel admin)
TELEGRAM_CHANNEL_ID=your_channel_chat_id_minus_100
