        description: "High-speed VPN with 50+ server locations and no-logs policy",
        image: "https://images.unsplash.com/photo-1556742049-0cfed4f7a07d?w=400&h=300&fit=crop",
        badgeColor: "bg-[var(--accent)]",
        badgeText: "Stock",
        action: "Add to Cart"
      }
    ];

    // ============================================
    // STATE & HELPER FUNCTIONS
    // ============================================
    const state = {
      cartCount: parseInt(localStorage.getItem('cartCount') || '0'),
      currentView: 'products'
    };

    // Render cart counter
    function renderCartCounter() {
      const counter = document.getElementById('cart-counter');
      if (counter) {
        counter.textContent = state.cartCount;
        counter.style.display = state.cartCount > 0 ? 'block' : 'none';
      }
    }

    // Render product card
    function renderProductCard(asset) {
      return `
        <div class="group card-hover p-4 rounded-lg flex flex-col h-full" data-index="${asset.id}">
          <!-- Image -->
          <div class="relative w-full h-48 rounded-t-lg overflow-hidden mb-4">
            <img src="${asset.image}" 
                 alt="${asset.name}" 
                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                 loading="lazy"
                 style="aspect-ratio/1">
          </div>

          <!-- Badge -->
          <span class="absolute top-2 left-2 ${asset.badgeColor} z-10">${asset.badgeText}</span>

          <!-- Content -->
          <div class="pt-4">
            <h3 class="font-medium mb-1 line-clamp-2">${asset.name}</h3>
            <p class="text-sm text-[var(--muted)] line-clamp-2 mb-3">${asset.description}</p>
            
            <!-- Price & Action -->
            <div class="flex items-baseline justify-between mt-3">
              <span class="text-[var(--accent)] font-bold">${asset.price}</span>
              <button class="add-to-cart text-[var(--accent)] text-sm hover:underline">${asset.action}</button>
            </div>
          </div>
        </div>
      `;
    }

    // Render product grid
    function renderProductGrid(filter = 'all') {
      const grid = document.getElementById('product-grid');
      if (!grid) return;

      const filteredAssets = digitalAssets.filter(asset => 
        filter === 'all' || asset.category === filter
      );

      grid.innerHTML = filteredAssets.map(renderProductCard).join('');

      // Add to cart functionality
      document.querySelectorAll('.add-to-cart').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const card = btn.closest('.group');
          const index = parseInt(card.dataset.index);
          addToCart(index);
        });
      });
    }

    // Add to cart
    function addToCart(index) {
      const asset = digitalAssets[index];
      state.cartCount++;
      localStorage.setItem('cartCount', state.cartCount);
      renderCartCounter();

      // Show feedback
      const originalText = btn.textContent;
      btn.textContent = 'Added ✓';
      btn.style.background = 'var(--accent)';
      btn.style.color = 'var(--bg)';
      
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = '';
        btn.style.color = '';
      }, 1500);
    }

    // Render gated products
    function renderGatedProducts() {
      const grid = document.getElementById('gated-products');
      if (!grid) return;

      grid.innerHTML = digitalAssets
        .filter(a => a.category === 'Storage/Vaults' || a.category === 'Accounts')
        .map(renderProductCard)
        .join('');
    }

    // Track order
    document.getElementById('track-order-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const orderId = document.getElementById('order-id').value.trim();
      const email = document.getElementById('order-email').value.trim();

      if (!orderId || !email) {
        showNotification('Please fill in both Order ID and Email', 'error');
        return;
      }

      // Show loading state
      const resultsDiv = document.getElementById('track-status');
      resultsDiv.innerHTML = `
        <div class="animate-spin rounded-full border-2 border-[var(--accent)] border-t-0 w-6 h-6 mx-auto mb-3"></div>
        <p class="text-sm">Fetching order status...</p>
      `;

      // Simulate API call
      setTimeout(() => {
        const statusDiv = document.getElementById('track-status');
        statusDiv.innerHTML = `
          <div class="p-4 rounded-lg bg-[var(--accent)]/10 border border-[var(--accent)]/20">
            <p class="font-medium">Order DTD-abc123</p>
            <p class="text-sm mt-1">Status: <span class="font-medium text-[var(--accent)]">Processing</span></p>
            <p class="text-sm mt-1">Estimated delivery: 2-4 business days</p>
            <p class="text-sm mt-1">Payment: <span class="font-medium">USDT (TRC20)</span></p>
          </div>
        `;
        document.getElementById('track-results').classList.remove('hidden');
      }, 1500);
    });

    // Telegram bot link
    document.querySelectorAll('a[href*="t.me/DTDSTOREBOT"]').forEach(link => {
      link.addEventListener('click', (e) => {
        // Track the click
        console.log('Telegram bot clicked');
      });
    });

    // Notification system
    function showNotification(message, type = 'info') {
      const colors = {
        success: 'var(--accent)',
        error: 'var(--danger)',
        info: 'var(--info)'
      };

      // Create notification element
      const notification = document.createElement('div');
      notification.className = `fixed top-4 left-1/2 transform -translate-x-1/2 px-4 py-2 rounded-lg shadow-lg ${
        colors[type] ? `bg-[${colors[type]}]` : ''
      } text-[var(--foreground)] transition-all duration-300`;
      notification.textContent = message;

      document.body.appendChild(notification);

      // Auto-remove after 3 seconds
      setTimeout(() => {
        notification.style.opacity = '0';
        notification.style.transition = 'opacity 0.3s ease';
        setTimeout(() => notification.remove(), 300);
      }, 3000);
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
      // Render product grids
      renderProductGrid('all');
      renderProductGrid('Infrastructure/SMTP');
      renderProductGrid('Storage/Vaults');
      renderProductGrid('Accounts');
      renderGatedProducts();
      renderCartCounter();

      // Navbar hover effect
      document.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('mouseenter', () => {
          document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('hover:text-[var(--foreground)']));
          link.classList.add('hover:text-[var(--foreground)']);
        });
      });

      // Chat form
      document.getElementById('chat-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const input = document.getElementById('chat-input');
        let message = input.value.trim();
        // XSS sanitization: escape HTML special characters
        message = message.replace(/&/g, '&').replace(/</g, '<').replace(/>/g, '>').replace(/"/g, '"').replace(/'/g, ''');
        if (!message) return;
        
        // Add message to chat history
        const chatHistory = document.getElementById('chat-history');
        const msgDiv = document.createElement('div');
        msgDiv.className = 'p-3 rounded-md mb-3';
        msgDiv.style.background = 'var(--bg-secondary)';
        msgDiv.innerHTML = `
          <div class="flex">
            <div class="w-8 h-8 rounded-full bg-[var(--accent)] flex items-center justify-center mr-3">
              <i class="fas fa-robot text-[var(--bg)] text-xs"></i>
            </div>
            <div>
              <p class="text-sm">${message}</p>
              <p class="text-[var(--muted)] text-xs">You</p>
            </div>
          </div>
        `;
        chatHistory.appendChild(msgDiv);
        chatHistory.scrollTop = chatHistory.scrollHeight;
        input.value = '';
      });
    });
  </script>
</body>
</html>