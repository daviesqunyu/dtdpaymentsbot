// ── DOM helpers ──
const $ = (sel) => document.querySelector(sel);
const $$ = (sel) => Array.from(document.querySelectorAll(sel));

function escapeHtml(s) {
  return String(s ?? '').replace(/&/g, '&').replace(/</g, '<').replace(/>/g, '>');
}

function sanitizeInput(s) {
  if (typeof s !== 'string') return '';
  return s
    .replace(/&/g, '&')
    .replace(/</g, '<')
    .replace(/>/g, '>')
    .replace(/"/g, '"')
    .replace(/'/g, ''')
    .replace(/\\/g, '&#92;')
    .substring(0, 500);
}

// Validation patterns
const PATTERNS = {
  orderId: /^DTD-[A-Za-z0-9]{3,16}$/,
  email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
};

function saveCart() {
  localStorage.setItem('dtd_cart', JSON.stringify(state.cart));
  updateCartCount();
}

function updateCartCount() {
  const badge = $('#cartBadge');
  const total = state.cart.reduce((sum, item) => sum + item.quantity, 0);
  if (badge) {
    badge.textContent = total;
    badge.style.display = total > 0 ? 'block' : 'none';
  }
}

// ── API ──
async function api(path, opts = {}) {
  const headers = { 'Content-Type': 'application/json' };
  if (opts.body && typeof opts.body !== 'string') opts.body = JSON.stringify(opts.body);
  const res = await fetch(`${API}${path}`, { ...opts, headers: { ...headers, ...(opts.headers || {}) }, credentials: 'include' });
  let data;
  try { data = await res.json(); } catch { data = {}; }
  if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
  return data;
}

// ── Analytics ──
function analyticsEvent(eventType, data = {}) {
  try {
    const payload = {
      clientId: state.analyticsId,
      sessionId: sessionStorage.getItem('dtd_session') || (() => { const s = crypto.randomUUID?.() || Math.random().toString(36).slice(2); sessionStorage.setItem('dtd_session', s); return s; })(),
      eventType, path: window.location.pathname, referrer: document.referrer,
      userAgent: navigator.userAgent, data, ts: Date.now(),
    };
    fetch('/api/analytics', { method: 'POST', body: JSON.stringify({ events: [payload] }), headers: { 'Content-Type': 'application/json' }, keepalive: true }).catch(() => {});
  } catch {}
}
function trackPageView() { analyticsEvent('page_view', { title: document.title }); }
function trackProductView(p) { analyticsEvent('product_view', { product_id: p.id, product_name: p.name, price_usd: p.price_usd }); }
function trackAddToCart(p) { analyticsEvent('add_to_cart', { product_id: p.id, product_name: p.name, price_usd: p.price_usd }); }
function trackPurchase(o) { analyticsEvent('purchase', { order_id: o.id, total_usd: o.total_usd }); }

// ── Product HTML ──
function productImage(p) {
  const imgUrl = PRODUCT_IMAGES[p.id] || 'https://images.unsplash.com/photo-1550684838-1028418563f2?w=400&h=300&fit=crop';
  return `<img src="${escapeHtml(imgUrl)}" alt="${escapeHtml(p.name)}" loading="lazy">`;
}

function productCardHTML(p) {
  const badgeClass = p.isGated ? 'badge-gated' : 'badge-active';
  const badgeText = p.isGated ? 'GATED' : 'ACTIVE';
  return `
    <div class="product-card page-enter reveal" style="animation-delay:${Math.random() * 0.3}s" onclick="window.location='/payment'">
      <div class="product-badge ${badgeClass}">${badgeText}</div>
      <div class="product-image">${productImage(p)}</div>
      <div class="product-overlay">
        <button class="btn btn-outline btn-sm" onclick="event.stopPropagation(); app.addToCart('${escapeHtml(p.id)}', '${escapeHtml(p.name)}', ${Number(p.price_usd)})">Quick Add</button>
        <a href="/payment" class="btn btn-primary btn-sm">Buy Now</a>
      </div>
      <div class="product-content">
        <div class="product-category">${p.category.toUpperCase()}</div>
        <h3 class="product-title">${escapeHtml(p.name)}</h3>
        <p class="product-desc">${escapeHtml(p.description || '')}</p>
      </div>
      <div class="product-footer">
        <div class="product-price">$${Number(p.price_usd).toFixed(2)}</div>
        <button class="btn btn-primary btn-sm" onclick="app.addToCart('${escapeHtml(p.id)}', '${escapeHtml(p.name)}', ${Number(p.price_usd)})">Add to Cart</button>
      </div>
    </div>
  `;
}

// ── App object (global for inline handlers) ──
const app = {
  addToCart(id, name, price) {
    const existing = state.cart.find(i => i.id === id);
    if (existing) existing.quantity += 1;
    else state.cart.push({ id, name, price, quantity: 1 });
    saveCart();
    trackAddToCart({ id, name, price });
    const btn = event.currentTarget;
    const original = btn.textContent;
    btn.textContent = 'Added ✓';
    btn.style.background = 'var(--neon-green)';
    btn.style.color = 'var(--bg)';
    setTimeout(() => { btn.textContent = original; btn.style.background = ''; btn.style.color = ''; }, 1200);
  },

  removeFromCart(id) {
    state.cart = state.cart.filter(i => i.id !== id);
    saveCart();
    renderCart();
  },

  async loadProducts() {
    try {
      const { products } = await api('/api/products');
      state.products = Array.isArray(products) ? products : DEFAULT_PRODUCTS;
    } catch { state.products = DEFAULT_PRODUCTS; }
  },

  renderProducts(containerId, filterCategory = null) {
    const container = $(containerId);
    if (!container) return;
    let list = state.products.length ? state.products : DEFAULT_PRODUCTS;
    if (filterCategory && filterCategory !== 'all') list = list.filter(p => p.category === filterCategory);
    container.innerHTML = list.map(p => productCardHTML(p)).join('');
    container.querySelectorAll('.product-card').forEach(card => {
      card.style.animationDelay = `${Math.random() * 0.3}s`;
    });
  },

  renderCategories() {
    const scroll = $('#catScroll');
    if (!scroll) return;
    scroll.innerHTML = PRODUCT_CATEGORIES.map(c => `
      <button class="cat-btn${c.id === state.category ? ' active' : ''}" onclick="app.filterCategory('${c.id}')">${c.icon} ${c.label}</button>
    `).join('');
  },

  filterCategory(cat) {
    state.category = cat;
    this.renderCategories();
    this.renderProducts('#homeGrid', cat);
  },

