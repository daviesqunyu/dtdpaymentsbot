    this.renderCategories();
    this.renderProducts('#homeGrid');
    this.initSlider(featured.length);
    this.bindAI();
  },

  initSlider(count) {
    if (!count) return;
    const track = $('#sliderTrack');
    const dots = $$('#sliderDots .slider-dot');
    const prev = $('#btnSliderPrev');
    const next = $('#btnSliderNext');
    let index = 0;
    function update() {
      if (!track) return;
      const first = track.querySelector('.slider-slide');
      if (!first) return;
      const rect = first.getBoundingClientRect();
      const slideWidth = rect.width + 16;
      track.scrollTo({ left: index * slideWidth, behavior: 'smooth' });
      dots.forEach((d, i) => d.classList.toggle('active', i === index));
    }
    if (next) next.onclick = () => { index = (index + 1) % count; update(); };
    if (prev) prev.onclick = () => { index = (index - 1 + count) % count; update(); };
    dots.forEach((d, i) => d.onclick = () => { index = i; update(); });
    setInterval(() => { index = (index + 1) % count; update(); }, 4000);
    update();
  },

async function veniceAIRequest(messages) {
  if (!VENICE_API_KEY) {
    return "Venice AI API key not configured. Please set VENICE_API_KEY in environment.";
  }
  try {
    const res = await fetch(`${VENICE_API_BASE}/v1/chat/completions`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${VENICE_API_KEY}`
      },
      body: JSON.stringify({
        model: VENICE_MODEL,
        messages: messages,
        stream: false,
        temperature: 0.7
      })
    });
    if (res.status === 401) {
      addMsg('⚠️ Unauthorized: Invalid Venice API key. Check VENICE_API_KEY environment variable.', 'error');
      return null;
    }
    if (!res.ok) {
      addMsg(`⚠️ Venice AI error (${res.status}): Network or server issue.', 'error');
      return null;
    }
    const data = await res.json();
    if (!data.choices || data.choices.length === 0) {
      addMsg('⚠️ Venice AI returned no response.', 'error');
      return null;
    }
    return data.choices[0].message.content;
  } catch (e) {
    if (e instanceof TypeError && e.message.includes('fetch')) {
      addMsg('⚠️ Network error: Could not reach Venice AI. Check your connection.', 'error');
    } else {
      addMsg(`⚠️ Venice AI exception: ${e.message}`, 'error');
    }
    return null;
  }
}

bindAI() {
    const input = $('#aiInput');
    const send = $('#aiSend');
    const chat = $('#aiChat');
    const quick = $$('.ai-qbtn');
    function addMsg(text, type) {
      const div = document.createElement('div');
      div.className = `ai-message ai-${type}`;
      div.textContent = text;
      chat.appendChild(div);
      chat.scrollTop = chat.scrollHeight;
    }
    async function sendToVenice(msg) {
      const botReply = await veniceAIRequest([
        { role: 'user', content: msg }
      ]);
      if (botReply) {
        addMsg(botReply, 'received');
      } else {
        addMsg("I'm having trouble reaching the AI service right now. Please try again shortly.", 'error');
      }
    }
    if (send) send.onclick = () => { const v = input.value.trim(); if (!v) return; addMsg(v, 'sent'); input.value = ''; sendToVenice(v); };
    if (input) input.onkeypress = (e) => { if (e.key === 'Enter') send.onclick(); };
    quick.forEach(b => b.onclick = () => { input.value = b.dataset.q; send.onclick(); });
  },

  renderCart() {
    const container = $('#cartContainer');
    if (!container) return;
    const total = state.cart.reduce((s, i) => s + i.price * i.quantity, 0);
    container.innerHTML = `
      <div class="ambient"></div>
      <section style="max-width:520px;margin:0 auto">
        <div class="eyebrow"><span class="kicker-dot"></span>Shopping Cart</div>
        <h1 class="page-title">Your Cart</h1>
        ${state.cart.length ? state.cart.map(i => `
          <div class="card mb-4" style="display:flex;align-items:center;gap:1rem">
            <img src="${PRODUCT_IMAGES[i.id] || ''}" style="width:80px;height:80px;object-fit:cover;border-radius:var(--radius-sm)">
            <div style="flex:1">
              <div class="product-title" style="margin-bottom:0.25rem">${escapeHtml(i.name)}</div>
              <div class="product-price" style="font-size:0.95rem">$${Number(i.price).toFixed(2)}</div>
              <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.5rem">
                <button class="btn btn-outline btn-sm" onclick="app.changeQty('${i.id}', -1)">−</button>
                <span>${i.quantity}</span>
                <button class="btn btn-outline btn-sm" onclick="app.changeQty('${i.id}', 1)">+</button>
                <button class="btn btn-danger btn-sm" style="margin-left:auto" onclick="app.removeFromCart('${i.id}')">Remove</button>
              </div>
            </div>
          </div>
        `).join('') : `<div class="text-center py-10"><div style="font-size:3rem;margin-bottom:1rem" aria-hidden="true">🛒</div><p class="text-cyber-muted">Your cart is empty.</p><a href="/" class="btn btn-primary">Start Shopping</a></div>`}
        <div class="mt-4">
          <div style="display:flex;justify-content:space-between;margin-bottom:1rem">
            <span class="text-cyber-muted">Total</span>
            <span class="product-price">$${total.toFixed(2)}</span>
          </div>
          <a href="/payment" class="btn btn-primary btn-block">Checkout</a>
        </div>
      </section>
    `;
  },

  changeQty(id, delta) {
    const item = state.cart.find(i => i.id === id);
    if (!item) return;
    item.quantity += delta;
    if (item.quantity <= 0) this.removeFromCart(id);
    else saveCart();
    this.renderCart();
  },
};

// ── Router ──
const routes = {
  '/': () => app.renderHome(),
  '/payment': () => renderPayment(),
  '/dtdshopcc': () => renderGated(),
  '/trade': () => renderTrade(),
  '/smtp': () => renderSmtp(),
  '/chat': () => renderChat(),
  '/track': () => renderTrack(),
  '/cart': () => app.renderCart(),
};

function router() {
  const path = window.location.pathname;
  const render = routes[path];
  if (render) render();
  else {
    $('#app').innerHTML = `<div class="text-cyber-neon-red text-center mt-10">404 — Page not found</div>`;
  }
}

// ── Boot ──
window.addEventListener('DOMContentLoaded', () => {
  const appEl = document.createElement('div');
  appEl.id = 'app';
  document.body.prepend(appEl);

  // Cart badge in header
  updateCartCount();

  // Mobile menu
  const btnMenu = document.getElementById('btnMenuToggle');
  const btnClose = document.getElementById('btnNavClose');
  const sideNav = document.getElementById('sideNav');
  if (btnMenu && sideNav) btnMenu.onclick = () => sideNav.classList.toggle('open');
  if (btnClose && sideNav) btnClose.onclick = () => sideNav.classList.remove('open');

  router();
  window.addEventListener('popstate', router);
});

// ── Placeholder renders for other pages (kept lightweight) ──
async function renderPayment() {
  $('#app').innerHTML = `
    <div class="ambient"></div>
    <section style="max-width:520px;margin:0 auto">
      <div class="eyebrow"><span class="kicker-dot"></span>Secure Checkout</div>
      <h1 class="page-title">Checkout</h1>
      <p class="page-subtitle mb-4">Pay with USDT (TRC20), Bitcoin (BTC), or Paystack card/bank.</p>
      <div class="card">
        <div class="form-group">
          <label class="form-label">Delivery Email</label>
          <input type="email" id="checkoutEmail" class="form-input" placeholder="you@example.com">
        </div>
        <div class="form-group">
          <label class="form-label">Payment Method</label>
          <div class="toggle-group">
            <button class="toggle-btn active" id="pmUsdt">USDT (TRC20)</button>
            <button class="toggle-btn" id="pmBtc">Bitcoin</button>
            <button class="toggle-btn" id="pmPaystack">Card / Bank</button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Amount (USD)</label>
          <input type="number" id="checkoutAmount" class="form-input" value="49" min="1">
        </div>
        <button class="btn btn-primary btn-block mt-4" id="btnCheckout">Continue to Payment</button>
      </div>
      <div id="checkoutAlert"></div>
      <p class="text-center text-cyber-muted text-sm mt-4">Join <a href="${TELEGRAM_BOT}" target="_blank" rel="noopener" style="color:var(--neon)">Telegram Bot</a> for support.</p>
    </section>
  `;
  let method = 'usdt';
  $$('#pmUsdt,#pmBtc,#pmPaystack').forEach(b => b.onclick = () => {
    $$('.toggle-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    method = b.id.replace('pm', '').toLowerCase();
  });
  $('#btnCheckout').onclick = async () => {
    const email = $('#checkoutEmail').value.trim();
    const amount = Number($('#checkoutAmount').value);
    const alertEl = $('#checkoutAlert');
    if (!email || !amount) { alertEl.innerHTML = '<div class="alert alert-error">Enter email and amount.</div>'; return; }
    try {
      await api('/api/orders', { method: 'POST', body: { customerName: 'Store Customer', customerEmail: email, paymentMethod: method, totalUsd: amount, items: [] } });
      state.checkout.step = 'paid';
      alertEl.innerHTML = '<div class="alert alert-success">Order created successfully!</div>';
      setTimeout(() => { window.location.href = '/track'; }, 1500);
    } catch (e) { alertEl.innerHTML = '<div class="alert alert-error">' + escapeHtml(e.message) + '</div>'; }
  };
}

